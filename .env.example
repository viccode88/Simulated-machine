# 複製為 .env 後修改
# 主機綁定位址：預設只綁本機，需要從實驗室 LAN 連入時改成 0.0.0.0
BIND_ADDR=127.0.0.1

# 實驗模式：true 才開放故障注入區域與 TRIP_TEST
LAB_MODE=false

# Modbus 逐筆請求日誌
MODBUS_TRACE=false

# 內建 DCS 是否自動執行冷啟動順序
AUTO_START=true

# 容器 restart 策略；要讓崩潰能被外部工具觀察時設為 "no"
DEVICE_RESTART=unless-stopped

# plant-bus 啟動後自動還原的快照名稱（留空則不還原）
RESTORE_ON_BOOT=

TZ=Asia/Taipei
