# 複製為 .env 後修改

# --- 啟動哪些服務 ---------------------------------------------------------
# 預設 standalone：`docker compose up` 就會帶起 8 台設備 + plant-bus +
# 內建 DCS + HMI + historian，機組會自己完成冷啟動並持續發電。
#
#   standalone    設備 + plant-bus + 內建 DCS + HMI + historian（自持運轉）
#   external-plc  設備 + plant-bus + HMI + historian，不啟動內建 DCS
#                 （由你自己的 PLC 透過 Modbus 控制）
#
# 要切換到 external-plc，改這一行，或在命令列前面覆蓋：
#   COMPOSE_PROFILES=external-plc docker compose up
#
# 注意：`--profile` 旗標是「疊加」在這個變數上的，不會取代它。
# 想只跑 external-plc 請用上面的環境變數寫法，不要用 `--profile external-plc`，
# 否則內建 DCS 會跟你的 PLC 同時控制同一批設備。
COMPOSE_PROFILES=standalone

# --- 網路 -----------------------------------------------------------------
# 主機綁定位址：預設只綁本機，需要從實驗室 LAN 連入時改成 0.0.0.0
BIND_ADDR=127.0.0.1

# --- 運轉 -----------------------------------------------------------------
# 內建 DCS 是否自動執行冷啟動順序（自持運轉的關鍵開關）
AUTO_START=true

# plant-bus 啟動後自動還原的快照名稱（留空則從冷態開始跑完整啟動順序）。
# 想要「開機瞬間就在滿載」：先跑一次完整啟動，等機組到達目標負載後執行
#     python -m tools.plantctl baseline
# 它會存下 steady-60mw 快照；把下面這行改成 RESTORE_ON_BOOT=steady-60mw，
# 之後每次 `docker compose up` 都會在數十毫秒內直接回到滿載運轉。
RESTORE_ON_BOOT=
# 還原前等待所有設備連上 plant-bus 的秒數；設備多或機器慢時可調大
RESTORE_ON_BOOT_DELAY=5

# 容器 restart 策略；要讓崩潰能被外部工具觀察時設為 "no"
DEVICE_RESTART=unless-stopped

# --- 實驗與除錯 -----------------------------------------------------------
# 實驗模式：true 才開放故障注入區域與 TRIP_TEST
LAB_MODE=false

# Modbus 逐筆請求日誌
MODBUS_TRACE=false

TZ=Asia/Taipei
