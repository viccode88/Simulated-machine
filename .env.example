# 複製為 .env 後修改

# --- 啟動哪一種 PLC -------------------------------------------------------
# 八台設備、plant-bus、HMI 與 historian 一律啟動；profile 只決定 PLC。
#
#   openplc-v4   OpenPLC Runtime v4（預設，ghcr.io 官方映像，Editor 由 8443 部署）
#   openplc-v3   OpenPLC Runtime v3（自原始碼建置，網頁介面在 15083）
#   no-plc       完全不啟動 PLC —— 設備是自持的，照樣會自己併聯發電
#
# 切換方式：改這一行，或在命令列覆蓋
#   COMPOSE_PROFILES=openplc-v3 docker compose up
#
# 注意：`--profile` 旗標是「疊加」在這個變數上，不是取代；
# 同時帶起 v3 與 v4 會搶同一個主機埠 15020。
COMPOSE_PROFILES=openplc-v4

# PLC 北向 Modbus server 對應到主機的哪個埠（SCADA/HMI 連這裡）
PLC_MODBUS_PORT=15020

# OpenPLC 映像。v4 用官方 ghcr.io 映像；v3 官方沒有發佈映像，預設由
# integrations/openplc/docker/Dockerfile.v3 建置（第一次要數分鐘）。
OPENPLC_V4_IMAGE=ghcr.io/autonomy-logic/openplc-runtime:latest
OPENPLC_V3_IMAGE=thermal-plant-openplc-v3:latest
OPENPLC_V3_REF=master
# v3 需要即時排程時設為 true（會以 privileged 執行）
OPENPLC_V3_PRIVILEGED=false

# --- 網路 -----------------------------------------------------------------
# 主機綁定位址：預設只綁本機，需要從實驗室 LAN 連入時改成 0.0.0.0
BIND_ADDR=127.0.0.1

# --- 運轉 -----------------------------------------------------------------
# 設備自持：允許條件成立就自行啟動，並由本地調節器維持程序量。
# 設為 false 時設備只會待機，必須由 SCADA/PLC 下 START 才啟動。
SELF_HOLD=true

# plant-bus 啟動後自動還原的快照名稱（留空則從冷態開始自行啟動）。
# 想要「開機瞬間就在滿載」：先跑一次完整啟動，等機組到達目標負載後執行
#     python -m tools.plantctl baseline
# 它會存下 steady-60mw 快照；把下面這行改成 RESTORE_ON_BOOT=steady-60mw，
# 之後每次 `docker compose up` 都會在數十毫秒內直接回到滿載運轉。
RESTORE_ON_BOOT=
# 還原前等待所有設備連上 plant-bus 的秒數；設備多或機器慢時可調大
RESTORE_ON_BOOT_DELAY=5

# 容器 restart 策略；要讓崩潰能被外部工具觀察時設為 "no"
DEVICE_RESTART=unless-stopped

# --- 實驗與除錯 -----------------------------------------------------------
# 實驗模式：true 才開放故障注入區域與 TRIP_TEST
LAB_MODE=false

# Modbus 逐筆請求日誌
MODBUS_TRACE=false

TZ=Asia/Taipei
